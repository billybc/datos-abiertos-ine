# Copia este archivo como .env y quita el # de las líneas que necesites. El archivo .env no se sube a GitHub.

# Base de datos en la nube. Si no la pones usa el archivo local ine.db
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/ine

# Obligatorio en la nube: clave larga y aleatoria que no debes cambiar después
# SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# COOKIE_SECURE=1
# PUBLIC_ONLY=1
# TRUST_PROXY=1

# Enlace público del portal, se usa en el correo de recuperación
# BASE_URL=https://portal.ejemplo.gob.gt

# Correo para recuperar contraseñas. Ejemplo con Gmail y contraseña de aplicación
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# SMTP_FROM=tucorreo@gmail.com
